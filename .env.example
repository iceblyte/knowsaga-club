# ============================================================
# 《知拾冒险社》环境变量模板
# ------------------------------------------------------------
# 用法：复制为 .env 后按注释填写。
#   cp .env.example .env        （Windows: copy .env.example .env）
# .env 已被 .gitignore 忽略，不会进入版本库；
# 本文件本身**不含任何敏感信息**，可以提交、可以开源。
# ============================================================

# ---------- DeepSeek（必填）----------
# 用途：AI 出题链 + 复盘报告链
# 获取：https://platform.deepseek.com/api_keys
# 注意：官方文档（2026-09 核对）当前可用模型为 deepseek-flash 与 deepseek-v4-pro，
#       旧的 deepseek-chat / deepseek-reasoner 已退役，写入会导致请求失败。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# MVP 出题链与报告链统一使用 flash（成本低、结构化输出稳定、延迟低）
DEEPSEEK_MODEL=deepseek-flash
# 预留：强推理档，后续报告深度不足时可切换
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
# 是否启用严格 JSON Schema 约束的工具调用（需 base_url 切到 /beta，属不稳定特性）
DEEPSEEK_USE_BETA=false
# 思维模式（DeepSeek 新参数）。出题/报告追求稳定，MVP 关闭。
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=medium

# 出题链参数（对应方案设计 §7.5）
QUIZ_TEMPERATURE=0.4
QUIZ_TOP_P=0.9
QUIZ_TIMEOUT_SECONDS=30
# DeepSeek 标准端点 max_tokens 上限 4096，故取值须保守以防 JSON 被截断
QUIZ_MAX_TOKENS=4096
QUIZ_MAX_RETRIES=2
# 整条兜底阶梯的**总时间预算**（秒）。超出后不再发起剩余尝试，直接快速失败。
# 为什么需要它：单次尝试超时 × 重试次数再叠上 HTTP 层重试，最坏情况会远超
# 用户愿意盯着「副本召唤中」等待的长度。宁可快速失败让用户重试。
QUIZ_GENERATION_BUDGET_SECONDS=50

# 报告链参数
REPORT_TEMPERATURE=0.5
REPORT_TOP_P=0.9
REPORT_TIMEOUT_SECONDS=30
REPORT_MAX_TOKENS=2048
REPORT_MAX_RETRIES=2

# 结构化输出策略（DeepSeek 不支持 OpenAI 的 json_schema strict，详见开发计划 §2.4.1）
# primary: json_mode（response_format=json_object）  fallback: function_calling（原生工具调用）
# 实测一次通过率 json_mode 100% > function_calling 67%，故以 json_mode 打头。
# 两者失效原因不同，保留另一条作降级通道。
STRUCTURED_OUTPUT_PRIMARY=json_mode
STRUCTURED_OUTPUT_FALLBACK=function_calling

# ---------- 联网检索（预留，可全部留空）----------
# 已按方案设计 §2.3 预留 Provider 抽象层：KNOWLEDGE_SEARCH_ENABLED=false 时
# 后端自动降级为「纯模型出题」，并把生成过程第一步显示为「理解你的输入」。
# 后续想开启真实联网，只需把 ENABLED 改为 true 并填入任一 Provider 的 Key。
KNOWLEDGE_SEARCH_ENABLED=false
KNOWLEDGE_SEARCH_PROVIDER=none
# 博查 AI（国内可直连）https://open.bochaai.com
BOCHA_API_KEY=
# Tavily https://tavily.com
TAVILY_API_KEY=

# ---------- 微信小程序（用户系统必需）----------
# 获取：微信公众平台 → 开发管理 → 开发设置 → 「小程序 ID」与「小程序密钥」
# 【重要】这两个值的安全级别完全不同，不要混为一谈：
#   · WECHAT_APPID = 公开标识符，**不是密钥**。它会被打进小程序安装包、能被
#     客户端 API 直接读到（wx.getAccountInfoSync().miniProgram.appId），
#     也出现在分享链接里 —— 天生无法保密，也不需要保密。写进
#     frontend/project.config.json 一并入库是官方推荐做法（见下「注意二」）。
#   · WECHAT_APP_SECRET = 真正的密钥，**只能存在于本文件（服务端）**。
#     泄漏后可被用来换取 access_token，进而调用该小程序的全部服务端接口。
#     绝对不要写进任何前端代码、不要写进 project.config.json。
# 注意一：测试号（appid 为 touristappid）**无法**换取用户身份，
#         做真实登录必须是正式注册的小程序。
# 注意二：AppID 必须与 frontend/project.config.json 的 appid 字段**保持一致**。
#         原因：wx.login 拿到的 code 是「由某个 appid 的小程序签发」的，
#         服务端必须用**同一个 appid** 去换取身份，否则微信会返回
#         40029（invalid code）。两处不一致时，登录会以「code 无效」的形式失败。
# 注意三：后端域名需加入「服务器域名」白名单（本机调试可在开发者工具勾选
#         「不校验合法域名」）；涉及头像昵称时还需在后台配置《用户隐私保护指引》，
#         未声明对应信息时平台会直接禁用相关能力。
WECHAT_APPID=
WECHAT_APP_SECRET=
# 调用微信接口的超时（秒）。上游抖动时不能把请求线程挂死。
WECHAT_TIMEOUT_SECONDS=8
# 身份校验实现：real（默认，生产必须用它）| mock（仅测试环境使用）。
# 【红线】模板默认值必须是生产安全的，所以这里只能是 real。
# 测试环境由 backend/tests/conftest.py 强制注入 mock，保证任何用例都不会
# 真的去请求微信服务器 —— 那会让测试变成「偶尔依赖外网」的不确定用例。
WECHAT_PROVIDER=real

# ---------- 登录限流 ----------
# 同一来源 IP 在窗口内允许的登录次数。登录是「换个 code 就能新建账号」的入口，
# 不限流等于把建档能力开放给脚本（code2Session 也有自己的分钟级配额）。
# 两个登录通道（微信 / 调试）各算各的额度。
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60

# ---------- 头像上传 ----------
# 单文件上限（字节），默认 2 MB；只接受 jpg / png / webp，且按**文件头魔数**
# 判类型（不信任 Content-Type 与扩展名），文件名由服务端生成。
AVATAR_MAX_BYTES=2097152
# 上传根目录，留空则用 backend/uploads。该目录不参与版本管理。
UPLOADS_DIR=

# ---------- 数据库（MySQL）----------
# 驱动：PyMySQL（同步，纯 Python，无需编译）。
#       为什么是同步而不是 aiomysql：本项目的接口全是同步 def，出题与报告链还跑在
#       ThreadPoolExecutor 后台线程里。异步驱动在后台线程中需要事件循环桥接，
#       同步驱动则到处都能直接用，少一层出错的地方。FastAPI 会把同步路由丢进
#       线程池执行，不会阻塞事件循环。
# 注意一：MySQL 9.x 已移除 mysql_native_password，账号默认 caching_sha2_password，
#         因此必须安装 cryptography 包（见 backend/requirements.txt）。
# 注意二：密码中的特殊字符必须做 URL 转义，例如 @ 要写成 %40，
#         否则会被当成 host 分隔符导致解析错误。
# 注意三：排序规则统一用 utf8mb4_0900_ai_ci（MySQL 8.0+/9.x 服务端默认），
#         不要用 utf8mb4_unicode_ci，库表连接不一致会导致跨表 JOIN 报
#         "Illegal mix of collations"。
# 注意四：测试库必须与业务库分离，因为 pytest 会反复建表清表。
# 建库建表脚本见 backend/sql/00_create_databases.sql 与 backend/sql/01_schema.sql
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/knowsaga_club?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/knowsaga_club_test?charset=utf8mb4

# ---------- 登录态（JWT）----------
# 必填，至少 32 个字符。缺失或过短时服务会拒绝启动（不使用默认弱密钥兜底）。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 更换密钥会让全部已签发的登录态立即失效（用户端会无感知地重新登录）。
JWT_SECRET=
# 登录态有效期（小时）。默认 7 天：覆盖「一周回来一次」的典型回访节奏；
# 失效后由客户端静默重建，用户无感。
JWT_EXPIRE_HOURS=168

# ---------- 业务时区 ----------
# 「今天」「连续天数」「错题到期」都按此时区判定。
# 数据库里统一存 UTC；若不固定此时区，晚上 8 点后的学习会被算到第二天。
APP_TIMEZONE=Asia/Shanghai

# ---------- 开发调试登录通道 ----------
# true 时额外注册一个按设备标识派生身份的调试入口，供 H5 / 本机联调使用；
# 否则除登录外的链路都无法在本机验证。**生产环境必须为 false**——
# 为 false 时该路由根本不存在（不是注册了再拒绝）。
DEV_LOGIN_ENABLED=false

# ---------- 服务配置 ----------
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------- 生成任务（异步轮询模式，对应原型 01 第 4 屏）----------
QUIZ_TASK_TTL_SECONDS=600
QUIZ_TASK_POLL_INTERVAL_MS=1200
