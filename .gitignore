.git/

# OS files
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
build/

# 中断安装留下的残缺依赖树与坏 lockfile
# 注意：node_modules.broken 不被上面的 node_modules/ 匹配（多了后缀），必须单独写，
# 否则 git add 会一口气吞掉两万多个文件。自检见 frontend/scripts/check_node_modules_integrity.py
node_modules.broken*/
package-lock.corrupt.json

# 原型解析 / 图标抽取的临时产物
.tmp*
.tmp_*/

# 浏览器实测（Playwright MCP）的截图 / 快照 / 控制台日志：本地产物，不入库
.playwright-mcp/

# 其他
.agents
skills-lock.json
.workbuddy-ai
.workbuddy
# OpenSpec 生成的 AI 客户端命令/技能文件（openspec update 会重写，属本地产物）
.codebuddy
# OpenSpec 使用教程：只留本机，不入库
docs/OpenSpec使用教程.md

# 原型：截图与临时渲染产物（可由 _gen/*.py 重新生成）
prototype/_shots/
prototype/_gen/_*.html

# ===== 环境变量：绝不允许提交，密钥只存在本地 =====
.env
.env.local
.env.*.local
*.env

# 保留模板文件，它是唯一可以入库的 env 文件
!.env.example

# ===== 前端 Taro 构建产物 =====
frontend/dist/
frontend/.temp/
frontend/.rn_temp/
frontend/.swc/
project.private.config.json

# ===== 后端本地缓存 =====
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
# 用户上传的头像等运行期文件：属于用户数据，绝不入库
# （知识库的原文件在 backend/uploads/kb/ 下，已被这一条覆盖）
backend/uploads/
# 私有知识库的向量库目录（Chroma 的持久化数据）。
# 它是**运行期数据**而不是代码：既大又是用户私有内容，绝不能入库。
# 部署时它必须落在有足够磁盘且会被备份的卷上。
backend/vectorstore/
# 沙箱内 pip 装不通时用来本地安装的 wheel 缓存
backend/.wheels/
.venv*/
.wheels/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
