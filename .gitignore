.git/

# OS files
Thumbs.db
Desktop.ini

# Editor files
.vscode/
.idea/

# Logs
*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/
build/

# 中断安装留下的残缺依赖树与坏 lockfile
# 注意：node_modules.broken 不被上面的 node_modules/ 匹配（多了后缀），必须单独写，
# 否则 git add 会一口气吞掉两万多个文件。自检见 frontend/scripts/check_node_modules_integrity.py
node_modules.broken*/
package-lock.corrupt.json

# 原型解析 / 图标抽取的临时产物
.tmp*
.tmp_*/

# 其他
.agents
skills-lock.json
.workbuddy-ai
.workbuddy

# 原型：截图与临时渲染产物（可由 _gen/*.py 重新生成）
prototype/_shots/
prototype/_gen/_*.html

# ===== 环境变量：绝不允许提交，密钥只存在本地 =====
.env
.env.local
.env.*.local
*.env

# 保留模板文件，它是唯一可以入库的 env 文件
!.env.example

# ===== 前端 Taro 构建产物 =====
frontend/dist/
frontend/.temp/
frontend/.rn_temp/
frontend/.swc/
project.private.config.json

# ===== 后端本地缓存 =====
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
# 用户上传的头像等运行期文件：属于用户数据，绝不入库
backend/uploads/
# 沙箱内 pip 装不通时用来本地安装的 wheel 缓存
backend/.wheels/
.venv*/
.wheels/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
